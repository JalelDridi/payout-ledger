// Constraints and triggers that Prisma cannot express live in the migration
// SQL and are described in docs/schema.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventSource {
  stripe
  simulator
}

enum AccountKind {
  external
  platform
  seller
}

enum TransactionKind {
  charge
  transfer
  payout
  payout_reversal
}

enum EventOutcome {
  applied
  stale
  ignored
}

enum PayoutStatus {
  pending
  in_transit
  paid
  failed
  canceled
}

/// Webhook inbox. The Stripe event ID is the primary key, so a duplicate
/// delivery is an insert conflict.
model StripeEvent {
  id          String        @id
  type        String
  source      EventSource
  apiCreated  DateTime      @map("api_created") @db.Timestamptz
  payload     Json
  receivedAt  DateTime      @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime?     @map("processed_at") @db.Timestamptz
  outcome     EventOutcome?
  attempts    Int           @default(0)
  lastError   String?       @map("last_error")

  transactions LedgerTransaction[]

  @@index([processedAt, apiCreated])
  @@map("stripe_events")
}

/// A ledger account. `balance` is a cache of the sum of its entries,
/// maintained by a trigger and guarded by a CHECK constraint.
model Account {
  id                 String      @id @default(uuid()) @db.Uuid
  code               String      @unique
  kind               AccountKind
  connectedAccountId String?     @unique @map("connected_account_id")
  allowNegative      Boolean     @default(false) @map("allow_negative")
  balance            BigInt      @default(0)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz

  entries LedgerEntry[]

  @@map("accounts")
}

/// One money movement. Its entries must sum to zero (deferred constraint
/// trigger). `idempotencyKey` makes a replayed write a conflict.
model LedgerTransaction {
  id             String          @id @default(uuid()) @db.Uuid
  kind           TransactionKind
  stripeObjectId String          @map("stripe_object_id")
  sourceEventId  String?         @map("source_event_id")
  idempotencyKey String          @unique @map("idempotency_key")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  sourceEvent StripeEvent?  @relation(fields: [sourceEventId], references: [id])
  entries     LedgerEntry[]

  @@index([stripeObjectId])
  @@index([sourceEventId])
  @@map("ledger_transactions")
}

/// One side of a transaction. Amounts are signed integer minor units
/// (cents). Rows are append-only.
model LedgerEntry {
  id            BigInt   @id @default(autoincrement())
  transactionId String   @map("transaction_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  amount        BigInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     Account           @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

/// Current state of a Stripe payout, built from events by a state machine
/// that only moves forward (ADR 5).
model Payout {
  id                 String       @id
  connectedAccountId String       @map("connected_account_id")
  amount             BigInt
  currency           String
  status             PayoutStatus
  failureCode        String?      @map("failure_code")
  arrivalDate        DateTime?    @map("arrival_date") @db.Timestamptz
  statusChangedAt    DateTime     @map("status_changed_at") @db.Timestamptz
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, statusChangedAt])
  @@index([connectedAccountId])
  @@map("payouts")
}

enum ObjectKind {
  charge
  transfer
  payout
}

enum MismatchType {
  missing_locally
  missing_at_source
  amount_mismatch
  status_mismatch
}

/// What the payment provider says exists. The simulator writes here when it
/// "creates" an object, whether or not the matching webhook is delivered, so
/// this table plays the role of the Stripe API for reconciliation.
model SourceObject {
  id                 String        @id
  kind               ObjectKind
  connectedAccountId String?       @map("connected_account_id")
  amount             BigInt
  status             PayoutStatus?
  updatedAt          DateTime      @map("updated_at") @db.Timestamptz

  @@map("source_objects")
}

model ReconciliationRun {
  id             String   @id @default(uuid()) @db.Uuid
  startedAt      DateTime @map("started_at") @db.Timestamptz
  finishedAt     DateTime @map("finished_at") @db.Timestamptz
  objectsChecked Int      @map("objects_checked")
  opened         Int
  stillOpen      Int      @map("still_open")
  resolved       Int

  @@index([startedAt])
  @@map("reconciliation_runs")
}

/// A difference between the source and this system. At most one open
/// mismatch per object and type (partial unique index in the migration).
model Mismatch {
  id         String       @id @default(uuid()) @db.Uuid
  objectId   String       @map("object_id")
  objectKind ObjectKind   @map("object_kind")
  type       MismatchType
  details    Json
  detectedAt DateTime     @map("detected_at") @db.Timestamptz
  lastSeenAt DateTime     @map("last_seen_at") @db.Timestamptz
  resolvedAt DateTime?    @map("resolved_at") @db.Timestamptz

  @@index([resolvedAt])
  @@map("mismatches")
}

enum AlertType {
  payout_failed
  payout_stuck
  event_unprocessable
}

/// Something a person should look at. An alert is open while its condition
/// holds; at most one open alert per type and subject (partial unique index
/// in the migration).
model Alert {
  id         String    @id @default(uuid()) @db.Uuid
  type       AlertType
  subjectId  String    @map("subject_id")
  message    String
  raisedAt   DateTime  @map("raised_at") @db.Timestamptz
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz

  @@index([resolvedAt])
  @@map("alerts")
}

# Copy to .env.local and fill in. Never commit real values.

# Postgres (Neon pooled connection string in production, Docker locally)
DATABASE_URL=
# Direct (unpooled) connection, used for migrations
DATABASE_URL_UNPOOLED=

# Stripe test mode only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signs events from the built-in simulator (any random string, e.g. whsec_sim_...)
SIMULATOR_WEBHOOK_SECRET=
